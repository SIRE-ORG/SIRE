// 1. Configuración del motor y la base de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  guest
  active
}

enum ReservationStatus {
  PENDING
  CANCELLED
  REJECTED
  COMPLETED
  FAILED
}

// 3. Modelos
model Profile {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  phone         String?
  accountStatus AccountStatus @default(guest)
  avatarUrl     String?
  createdAt     DateTime      @default(now())

  // Relaciones: Un perfil puede ser dueño de muchas publicaciones y hacer muchas reservas
  publications Publication[]
  reservations Reservation[]

  // Esto le dice a Prisma que en Supabase la tabla se llama "profiles" (en minúscula y plural)
  @@map("profiles")
}

enum PublicationCategory {
  DEPORTE
  EVENTOS
  RECREACION
  OTROS
}

model Publication {
  id           String              @id @default(uuid())
  title        String
  description  String
  category     PublicationCategory
  imageUrl     String?
  region       String
  city         String?
  isActive     Boolean             @default(true)
  availability Json // Aquí guardaremos los horarios en formato JSON
  createdAt    DateTime            @default(now())

  // Llave Foránea: Quién es el dueño de esta publicación
  ownerId String
  owner   Profile @relation(fields: [ownerId], references: [id])

  // Relación: Una publicación puede tener muchas reservas
  reservations Reservation[]

  @@map("publications")
}

model Reservation {
  id        String            @id @default(uuid())
  date      DateTime
  startTime String
  endTime   String
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  // Llave Foránea: A qué publicación pertenece la reserva
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id])

  // Llave Foránea: Quién solicitó la reserva
  solicitanteId String
  solicitante   Profile @relation(fields: [solicitanteId], references: [id])

  @@map("reservations")
}