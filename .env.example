# ============================================
# SIRE — Variables de entorno (Flutter/Dart)
# ============================================
# Copia este archivo como ".env" y completa
# los valores con los datos de tu proyecto.
# ============================================

# URL del proyecto en Supabase
SUPABASE_URL=

# Clave anónima de Supabase (anon/public key)
SUPABASE_ANON_KEY=

# URL base del backend REST (Fastify)
API_BASE_URL=

# API key de Google Geocoding — opcional
GOOGLE_GEOCODING_KEY=
